PORT=4176
PUBLIC_SITE_URL=http://localhost:4176
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:4176/auth/kakao/callback
SESSION_SECRET=replace-with-a-long-random-string
DATABASE_PATH=./data/app.sqlite
ACCOUNT_FEATURE_ENABLED=true

# Search trend integrations:
# - NAVER_DATALAB_* enables the real NAVER DataLab Search Trend API.
# - Daum search interest uses KAKAO_REST_API_KEY above through Kakao Daum Search API.
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=

# Optional custom JSON providers if you run your own trend collector.
# Expected item shape: [{ "title": "keyword", "traffic": "1,000건", "url": "https://..." }]
NAVER_TREND_API_URL=
DAUM_TREND_API_URL=

# Render MVP example:
# PUBLIC_SITE_URL=https://wingcoupang.site
# KAKAO_REDIRECT_URI=https://wingcoupang.site/auth/kakao/callback
# DATABASE_PATH=./data/app.sqlite
# ACCOUNT_FEATURE_ENABLED=false
#
# Paid storage upgrade example:
# DATABASE_PATH=/data/app.sqlite
# ACCOUNT_FEATURE_ENABLED=true
